{
  "name": "study-timer",
  "version": "1.0.0",
  "description": "Simple timer and stopwatch for studying",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.study.timer",
    "productName": "Study Timer",
    "files": ["main.js", "index.html", "package.json"],
    "win": { "target": "portable", "signAndEditExecutable": false }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
